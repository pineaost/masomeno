# URL del proyecto y clave publicable de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen HTTPS canónico para enlaces de correo, sin ruta. Vercel puede usar su dominio automático.
# npm run dev usa http://localhost:3000 si no se especifica.
# MASOMENO_SITE_URL=https://tu-dominio

# Optativo. Solo activa el modo demo en npm run dev.
# MASOMENO_DEMO_MODE=true
